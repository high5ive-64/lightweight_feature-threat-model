# ============================================
# Feature Threat Model - Configuration File
# ============================================
# Copy this file to .env and edit the values.
# DO NOT commit .env to version control.

# --------------------------------------------
# Application Settings
# --------------------------------------------
APP_NAME="Feature Threat Model API"
HOST=0.0.0.0
PORT=8000
RELOAD=true

# --------------------------------------------
# Provider Selection
# --------------------------------------------
# Options: "openai", "lmstudio", or "claude"
PROVIDER=openai

# --------------------------------------------
# OpenAI Settings (used when PROVIDER=openai)
# --------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: Custom OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://your-custom-endpoint.com/v1

# --------------------------------------------
# LM Studio Settings (used when PROVIDER=lmstudio)
# --------------------------------------------
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=your-loaded-model-name

# --------------------------------------------
# Claude Settings (used when PROVIDER=claude)
# --------------------------------------------
CLAUDE_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
# Alternative models: claude-opus-4-20250514, claude-3-5-sonnet-20241022

# --------------------------------------------
# Threat Model Generation Settings
# --------------------------------------------
MAX_RETRIES=2
DEFAULT_SEVERITY=Medium